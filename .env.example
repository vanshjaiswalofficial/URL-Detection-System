# PhishGuard AI - Environment Configuration Example
# Copy to .env and customize. Do not commit .env to version control.

# Application & API
PHISHGUARD_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_KEY_SALT=change-me-in-production-salt-phrase
API_KEYS=dev-key-1:test_key_secret

# Database
DATABASE_URL=sqlite:///./phishguard.db

# Privacy Defaults (RULES R-PRIV-1)
STORE_URLS_DEFAULT=false
RETENTION_DAYS=30

# Feature Flags & External Feeds (RULES R-CODE-6: offline by default)
OPENPHISH_ENABLED=false
OPENPHISH_FEED_URL=https://openphish.com/feed.txt

URLHAUS_ENABLED=false
URLHAUS_AUTH_KEY=

SAFE_BROWSING_ENABLED=false
SAFE_BROWSING_API_KEY=

# ML Model Settings
MODEL_VERSION=v0.1-baseline
ACTIVE_MODEL_DIR=models/v0.1-baseline
ENABLE_CHAR_CNN=false
MAX_URL_LENGTH=2048
